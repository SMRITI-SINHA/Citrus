{
  "name": "@citrus/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/cluster.ts",
    "build": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts --reset",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "seed:queue": "tsx src/db/seed-queue.ts",
    "start:single": "node --import tsx src/server.ts",
    "load": "tsx load/roadshow.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "oracledb": "^7.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}